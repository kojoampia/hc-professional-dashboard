# Copy to .env next to docker-compose.professional.yml and fill in.
# Keep the real file out of git and chmod 600 — it holds the JWT signing key.

# Image coordinates. Empty REGISTRY_PREFIX uses locally built images;
# on the server set it to the private registry (with trailing slash).
REGISTRY_PREFIX=
# REGISTRY_PREFIX=docker-registry.jojoaddison.net/
IMAGE_TAG=latest

# REQUIRED - shared JWT signing key for gateway + professionalService.
# Generate with: openssl rand -base64 64  (join the two lines into one)
JWT_BASE64_SECRET=

# Public base URL (activation/reset emails link here)
PORTAL_BASE_URL=https://professional.abofonsa.com

# SMTP for account emails (activation, password reset). Leave as-is to
# disable outbound mail (sends will fail loudly in the gateway log).
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
