# `npm ci` does not resolve this tree without it, on any machine.
#
# browser-sync-webpack-plugin@2.3.0 declares a peer of browser-sync@^2 that npm's strict resolver
# rejects against the rest of the Angular 19 toolchain, so a clean clone cannot install — which is
# what the README has always told people to do. It looked fine only because an existing
# node_modules hides it; the failure appears the first time anyone installs from scratch, which for
# most of this repository's life was nobody.
#
# deploy/docker/web.Dockerfile has been passing --legacy-peer-deps on the command line since the
# image was first built. Stating it here instead means the laptop, CI and the production image all
# resolve the same tree, rather than the image being the only path that works.
legacy-peer-deps=true
