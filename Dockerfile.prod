# WP8 production image: build the Angular bundle, serve it with nginx.
# The prod webpack build bakes SERVER_API_URL='/' (webpack.custom.js), so all
# API calls are same-origin and nginx proxies them to the gateway container —
# see nginx.conf for the proxied path set.

# Stage 0: compile angular frontend
# (Debian-based image: npm crashes with "Exit handler never called!" on alpine/musl here)
FROM node:22-bookworm AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund --loglevel=warn
COPY . .
RUN npm run webapp:prod

# Stage 1: serve app with nginx
FROM nginx:1.27-alpine
COPY --from=build /app/target/classes/static/ /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
