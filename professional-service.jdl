// Entities owned by professionalService.
//
// Entity-only JDL: application config lives in .yo-rc.json, so this file can be
// applied with `jhipster jdl professional-service.jdl` without duplicating it.
//
// DutyRoster, DutyShift and HealthConnectProfessional mirror
// app/health-connect/health-connect.models.ts. The rest are the older generated
// definitions this repo has carried since 2024; their Angular modules were
// deleted before the BridgeCare migration and are regenerated here.

@ChangelogDate("20240326164027")
entity Activity (activity) {
  id String
  name String
  description String
  patientId String
  createdDate Instant
  createdBy String
  modifiedDate Instant
  modifiedBy String
}

@ChangelogDate("20240206205816")
entity Address (address) {
  id String
  digitalAddress String
  streetAddress String
  areaCode String
  town String
  city String
  district String
  state String
  region String
  country String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20240320235005")
entity Document (jhi_document) {
  id String
  name String
  profileId String
  data AnyBlob
  type DocumentType
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20260724060000")
entity DutyRoster (dutyroster) {
  id String
  name String
}

@ChangelogDate("20260724060100")
entity DutyShift (dutyshift) {
  id String
  professionalId String
  startsAt Instant
  endsAt Instant
  status DutyShiftStatus
}

@ChangelogDate("20260724060200")
entity HealthConnectProfessional (healthconnectprofessional) {
