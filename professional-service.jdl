// Entities owned by professionalService.
//
// Entity-only JDL: application config lives in .yo-rc.json, so this file can be
// applied with `jhipster jdl professional-service.jdl` without duplicating it.
//
// DutyRoster, DutyShift and HealthConnectProfessional mirror
// app/health-connect/health-connect.models.ts. The rest are the older generated
// definitions this repo has carried since 2024; their Angular modules were
// deleted before the BridgeCare migration and are regenerated here.

@ChangelogDate("20240326164027")
entity Activity (activity) {
  id String
  name String
  description String
  patientId String
  createdDate Instant
  createdBy String
  modifiedDate Instant
  modifiedBy String
}

@ChangelogDate("20240206205816")
entity Address (address) {
  id String
  digitalAddress String
  streetAddress String
  areaCode String
  town String
  city String
  district String
  state String
  region String
  country String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20240320235005")
entity Document (jhi_document) {
  id String
  name String
  profileId String
  data AnyBlob
  type DocumentType
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20260724060000")
entity DutyRoster (dutyroster) {
  id String
  name String
}

@ChangelogDate("20260724060100")
entity DutyShift (dutyshift) {
  id String
  professionalId String
  startsAt Instant
  endsAt Instant
  status DutyShiftStatus
}

@ChangelogDate("20260724060200")
entity HealthConnectProfessional (healthconnectprofessional) {
  id String
  accountLogin String
  name String
  role String
}

@ChangelogDate("20240206215539")
entity Medication (medication) {
  id String
  name String
  description String
  prescription String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20240206220638")
entity Metadata (metadata) {
  id String
  createdBy String
  modifiedBy String
  createdDate LocalDate
  modifiedDate LocalDate
  data String
}

@ChangelogDate("20240206221158")
entity Profile (profile) {
  id String
  firstName String
  middleNames String
  lastName String
  team String
  birthDate LocalDate
  sex String
  mobilePhone String
  phoneNumber String
  email String
  idType String
  idNumber String
  documents String
  address String
  bankAccount String
  tenantId String
  rosterId String
  teamId String
}

@ChangelogDate("20240206220512")
entity Report (report) {
  id String
  category String
  description String
  name String
  url String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20240206215832")
entity Stat (stat) {
  id String
  type String
  name String
  description String
  value Double
  note String
  createdDate LocalDate
  createdBy String
}

@ChangelogDate("20240206220119")
entity Task (task) {
  id String
  name String
  description String
  schedule LocalDate
  duration Double
  attendantId String
  teamId String
  patientId String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

@ChangelogDate("20240206215921")
entity Team (team) {
  id String
  name String
  description String
  contact String
}

enum DocumentType {
  PASSPORT,
  CERTIFICATE,
  LICENSE,
  GHANACARD,
  PASSPHOTO,
  DRIVERLICENSE,
  VOTERCARD,
  NHIS,
  OTHER
}

enum DutyShiftStatus {
  UPCOMING,
  ACTIVE,
  COMPLETED
}

// Replaces DutyRoster.subscribedProfessionalIds: string[] and its inverse
// HealthConnectProfessional.dutyRosterIds: string[], which were both flattened
// to String because JDL has no array field type. Field names are SINGULAR on
// purpose: JHipster pluralises the to-many side.
relationship ManyToMany {
  DutyRoster{subscribedProfessional} to HealthConnectProfessional{dutyRoster}
}

// Replaces DutyRoster.shifts: DutyShift[]. The relationship also supplies what
// DutyShift.rosterId used to carry, so that scalar is gone.
relationship OneToMany {
  DutyRoster{shifts} to DutyShift{roster}
}

microservice Activity, Address, Document, DutyRoster, DutyShift, HealthConnectProfessional, Medication, Metadata, Profile, Report, Stat, Task, Team with professionalService
clientRootFolder Activity, Address, Document, DutyRoster, DutyShift, HealthConnectProfessional, Medication, Metadata, Profile, Report, Stat, Task, Team with professionalService
service Document, DutyRoster, DutyShift, HealthConnectProfessional, Profile with serviceClass
search Activity, Address, Document, DutyRoster, DutyShift, HealthConnectProfessional, Medication, Metadata, Profile, Report, Stat, Task, Team with no
paginate Profile with pagination
