application {
  config {
    baseName professionalDashboard
    clientFramework angular
    clientTheme none
    creationTimestamp 1707426466782
    databaseType mongodb
    devDatabaseType mongodb
    enableTranslation true
    jhiPrefix hpd
    jhipsterVersion "9.1.0"
    languages [en, fr, de]
    microfrontends []
    nativeLanguage en
    prodDatabaseType mongodb
    skipServer true
    testFrameworks [cypress]
    withAdminUi true
  }

  entities Activity, ActivityLogEntry, Address, ClinicalReport, Document, DutyRoster, DutyShift, HealthConnectProfessional, MedCase, Medication, MedicationRecord, Metadata, Patient, Profile, Recommendation, Report, Stat, Task, Team, Visitation
}

